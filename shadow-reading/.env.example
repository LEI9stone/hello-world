MYSQL_DATABASE=shadow_reading
MYSQL_USER=shadow
MYSQL_PASSWORD=shadow_dev
MYSQL_ROOT_PASSWORD=shadow_root_dev
# 本机 Go 服务连接 Docker 中的 MySQL（宿主机端口 3307）。
MYSQL_DSN=shadow:shadow_dev@tcp(127.0.0.1:3307)/shadow_reading?charset=utf8mb4&parseTime=true
# Go 后端监听端口，与前端 Vite 代理保持一致。
PORT=8081
# Edge TTS 可执行文件路径（服务端生成朗读音频使用）。
# 缺省时按 EDGE_TTS_BIN → PATH 中的 edge-tts → ~/.venvs/edge-tts/bin/edge-tts 依次查找；
# 都找不到时服务仍可正常启动，仅朗读音频接口返回 503。
EDGE_TTS_BIN=/Users/xiaolei/.venvs/edge-tts/bin/edge-tts
# 朗读音频缓存根目录，文件形如 {AUDIO_DIR}/{文章ID}/{音色}/{段落序号}-{文本哈希}.mp3。
AUDIO_DIR=./storage/audio
